{
  "name": "@isdk/match-ex",
  "version": "0.1.0",
  "author": "Riceball LEE <snowyu.lee@gmail.com>",
  "description": "A declarative, weight-aware matching/validation engine: match actual values against an expectation tree using operators ($and, $or, $contains, $each, ...), JSON Schema, diffs and templates. Framework-agnostic -- usable in plain fixture-driven integration tests, response contract checks and the browser.",
  "keywords": [
    "match",
    "match-ex",
    "validate",
    "validation",
    "expect",
    "assert",
    "operators",
    "json-schema",
    "diff",
    "scoring",
    "isdk"
  ],
  "homepage": "https://github.com/isdk/match-ex.js",
  "repository": "https://github.com/isdk/match-ex.js",
  "bugs": "https://github.com/isdk/match-ex.js/issues",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "import": "./dist/loader.js",
      "require": "./dist/loader.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build-fast": "tsup",
    "build": "pnpm run build-fast --dts-resolve --dts",
    "clean": "rm -fr dist",
    "format": "pnpm run format:base -c",
    "format:base": "prettier \"src/**/*.{ts,tsx,js,jsx,md}\"",
    "format:fix": "pnpm run format:base --write",
    "lint": "eslint .",
    "style": "pnpm run format:base -c && pnpm run lint",
    "style:fix": "pnpm run format:fix && npm run lint --fix",
    "test": "vitest run",
    "release": "pnpm run clean && pnpm run build && pnpm dlx commit-and-tag-version -s",
    "release.alpha": "pnpm run release -- --prerelease alpha"
  },
  "dependencies": {
    "diff": "^8.0.3",
    "lodash-es": "^4.17.23",
    "util-ex": "^2.5.2"
  },
  "devDependencies": {
    "@isdk/match-ex-schema": "workspace:^",
    "@isdk/template-engines": "workspace:^",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.1.0",
    "prettier": "^3.8.1",
    "terser": "^5.46.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "~5.7.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.0.18"
  }
}
